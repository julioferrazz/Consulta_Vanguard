# ============================================================
#  CONFIGURAÇÕES DO SISTEMA CORBAN - CONSULTA MARGEM POR CPF
# ============================================================

# Lista de contas com suporte a rotação automática por limite diário
# Formato: usuario1:senha1,usuario2:senha2,usuario3:senha3
CORBAN_CONTAS=ti@37277:Safira@26,Gestor@37277:Vanguard@@,Supervisao@37277:Safira@26

# Ou contas individuais alternativas:
# CORBAN_USUARIO_1=ti@37277
# CORBAN_SENHA_1=Safira@26
# CORBAN_USUARIO_2=Gestor@37277
# CORBAN_SENHA_2=Vanguard@@

# URL do portal
SITE_URL=https://gestao.sistemacorban.com.br

# Arquivos de dados (não são versionados no Git)
ARQUIVO_ENTRADA=cpfs.csv
ARQUIVO_SAIDA=resultados.csv

# Parâmetros de execução
MODO_VISIVEL=true
TEMPO_ESPERA=2
TIMEOUT_RESPOSTA=20
LIMITE_CPFS=500
INTERVALO_CHECKPOINT=10
