# ============================================================
# EXEMPLO DE ARQUIVO .ENV - SISTEMA CORBAN
# ============================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.

# Lista de contas com rotação automática ao atingir o limite diário:
# Formato: usuario1:senha1,usuario2:senha2,...
CORBAN_CONTAS=usuario1@empresa:senha1,usuario2@empresa:senha2

# Ou contas individuais:
# CORBAN_USUARIO_1=usuario1@empresa
# CORBAN_SENHA_1=senha1
# CORBAN_USUARIO_2=usuario2@empresa
# CORBAN_SENHA_2=senha2

# Arquivos e Parâmetros:
ARQUIVO_ENTRADA=telefones-base safira-menos juros.csv
ARQUIVO_SAIDA=resultados_telefones.csv
ARQUIVO_HISTORICO=telefones_consultados.txt

MODO_VISIVEL=true
TEMPO_ENTRE_BUSCAS=10
TIMEOUT_RESPOSTA=20
LIMITE_REGISTROS=5000
INTERVALO_CHECKPOINT=5
